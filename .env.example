NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/g3soft
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:3000
SEED_ADMIN_EMAIL=admin@g3soft.local
SEED_ADMIN_PASSWORD=CHANGE-ME-WITH-A-12-CHAR-MINIMUM-PASSWORD

# Para desenvolvimento conectado ao PostgreSQL remoto do Render, substitua DATABASE_URL
# por uma credencial armazenada apenas no seu .env local. Nunca comite o valor real.
# DB_SSL=false somente para PostgreSQL local quando necessário.

# IA do Diagnóstico 360 — opcional. Configure no Render para habilitar a análise via OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Growth attribution / public links
G3_PUBLIC_URL=https://g3soft.com.br
ATTRIBUTION_HASH_SALT=change-this-in-production

# WhatsApp Cloud API — optional until Meta credentials and approved templates are configured
WHATSAPP_SALES_NUMBER=5516992249258
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
