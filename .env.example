NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/g3soft
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:3000
SEED_ADMIN_EMAIL=admin@g3soft.local
SEED_ADMIN_PASSWORD=CHANGE-ME-WITH-A-12-CHAR-MINIMUM-PASSWORD

# Para desenvolvimento conectado ao PostgreSQL remoto do Render, substitua DATABASE_URL
# por uma credencial armazenada apenas no seu .env local. Nunca comite o valor real.
# DB_SSL=false somente para PostgreSQL local quando necessário.
